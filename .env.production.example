# Copy this to `.env` on the production server and fill in real values.
# Never commit the real .env -- it's already gitignored.

# --- Domain -----------------------------------------------------------------
# The domain Caddy will request a Let's Encrypt certificate for, and the base URL
# used to build links sent back through Telegram/email. Must be a real resolvable
# domain (a free one from duckdns.org works fine) -- Let's Encrypt cannot issue a
# certificate for a bare IP address.
DOMAIN=queueflow-pilot.duckdns.org
PUBLIC_BASE_URL=https://queueflow-pilot.duckdns.org

# --- Secrets ------------------------------------------------------------------
# Generate strong values for these -- do not reuse the local-dev placeholders.
# On any machine with Python: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
JWT_SECRET=

# --- Telegram -----------------------------------------------------------------
# From @BotFather when you create the bot.
TELEGRAM_BOT_TOKEN=
# The bot's @username, without the @.
TELEGRAM_BOT_USERNAME=

# --- Email (SMTP fallback) -----------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
